{
    "Comment": "My first Step Functions workflow",
    "StartAt": "Process",
    "States": {
        "Process": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${ProcessFunctionArn}",
                "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "End": true
        }
    }
}